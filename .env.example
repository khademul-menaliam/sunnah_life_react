# ==============================================================================
# Sunnah of Life - React & Supabase & Cloudinary Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Database, Auth & Realtime)
# ------------------------------------------------------------------------------
# How to get these:
# 1. Sign up/Log in at https://supabase.com
# 2. Create a new project (e.g., "sunnah-of-life")
# 3. Go to Project Settings -> API
# 4. Copy "Project URL" and "Project API Keys (anon public)"
# 5. Open the SQL Editor in Supabase and run the queries in `supabase/schema.sql` and `supabase/seed.sql`
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. CLOUDINARY CONFIGURATION (Image Storage & Media Deliveries)
# ------------------------------------------------------------------------------
# How to get these:
# 1. Sign up/Log in at https://cloudinary.com
# 2. Go to Dashboard -> copy your "Cloud Name"
# 3. Go to Settings (gear icon) -> Upload -> Scroll down to "Upload presets"
# 4. Click "Add upload preset", set "Signing Mode" to "Unsigned", and name it (e.g. "sunnah_preset")
# 5. Paste the cloud name and preset name below:
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
